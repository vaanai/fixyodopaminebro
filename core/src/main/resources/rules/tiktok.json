{
  "schemaVersion": 2,
  "app": "tiktok",
  "displayName": "TikTok",
  "packages": ["com.zhiliaoapp.musically", "com.ss.android.ugc.trill"],
  "version": 4,
  "verified": true,
  "tabBarSignal": "tabBar",
  "signatureIds": [],
  "autoSkipTarget": "inbox",
  "launch": { "surface": "for_you", "signal": "videoActions", "note": "TikTok opens on For You; at cold start the first reads stop inside the video pager before the tabs" },
  "signals": {
    "tabBar": [
      { "text": "Inbox", "minTopFraction": 0.8 },
      { "desc": "Inbox", "minTopFraction": 0.8 },
      { "text": "Home", "minTopFraction": 0.8 },
      { "desc": "Home", "minTopFraction": 0.8 }
    ],
    "homeSelected": [
      { "text": "Home", "minTopFraction": 0.8, "selected": true },
      { "desc": "Home", "minTopFraction": 0.8, "selected": true }
    ],
    "friendsSelected": [
      { "text": "Friends", "minTopFraction": 0.8, "selected": true },
      { "desc": "Friends", "minTopFraction": 0.8, "selected": true }
    ],
    "inboxSelected": [
      { "text": "Inbox", "minTopFraction": 0.8, "selected": true },
      { "desc": "Inbox", "minTopFraction": 0.8, "selected": true }
    ],
    "profileSelected": [
      { "text": "Profile", "minTopFraction": 0.8, "selected": true },
      { "desc": "Profile", "minTopFraction": 0.8, "selected": true }
    ],
    "topTabs": [
      { "text": "For You", "maxBottomFraction": 0.25 },
      { "desc": "For You", "maxBottomFraction": 0.25 }
    ],
    "forYouSelected": [
      { "text": "For You", "maxBottomFraction": 0.25, "selected": true },
      { "desc": "For You", "maxBottomFraction": 0.25, "selected": true }
    ],
    "followingSelected": [
      { "text": "Following", "maxBottomFraction": 0.25, "selected": true },
      { "desc": "Following", "maxBottomFraction": 0.25, "selected": true }
    ],
    "friendsTopSelected": [
      { "text": "Friends", "maxBottomFraction": 0.25, "selected": true },
      { "desc": "Friends", "maxBottomFraction": 0.25, "selected": true }
    ],
    "exploreSelected": [
      { "text": "Explore", "maxBottomFraction": 0.25, "selected": true },
      { "desc": "Explore", "maxBottomFraction": 0.25, "selected": true }
    ],
    "liveRoom": [
      { "id": "ttlive_link_layout_layer_root", "note": "LivePlayActivity; the LIVE icon top-left opens this, there is no LIVE top tab" },
      { "id": "ttlive_", "minHeightFraction": 0.5 }
    ],
    "liveSelected": [
      { "text": "LIVE", "maxBottomFraction": 0.25, "selected": true },
      { "desc": "LIVE", "maxBottomFraction": 0.25, "selected": true }
    ],
    "shopSelected": [
      { "text": "Shop", "maxBottomFraction": 0.25, "selected": true },
      { "desc": "Shop", "maxBottomFraction": 0.25, "selected": true }
    ],
    "videoActions": [
      { "descStartsWith": "Like video" },
      { "descContains": "Read or add comments" },
      { "descStartsWith": "Share video" },
      { "descContains": "Add or remove this video from Favorites" },
      { "labelRegex": "^Like\\b.*\\d", "note": "Like button with a count, e.g. 'Like 12.3K'" }
    ],
    "dmComposer": [
      { "editable": true, "hintContains": "message" },
      { "cls": "EditText", "hintContains": "Send a message" }
    ],
    "inboxTab": [
      { "text": "Inbox", "minTopFraction": 0.8 },
      { "desc": "Inbox", "minTopFraction": 0.8 }
    ],
    "friendsTab": [
      { "text": "Friends", "minTopFraction": 0.8 },
      { "desc": "Friends", "minTopFraction": 0.8 }
    ],
    "profileTab": [
      { "text": "Profile", "minTopFraction": 0.8 },
      { "desc": "Profile", "minTopFraction": 0.8 }
    ]
  },
  "surfaces": [
    { "id": "for_you", "label": "For You", "kind": "VIDEO_FEED", "description": "The main algorithmic feed TikTok opens on, plus the nearby (local) tab." },
    { "id": "following", "label": "Following", "kind": "VIDEO_FEED", "description": "Videos from accounts you follow." },
    { "id": "friends", "label": "Friends", "kind": "VIDEO_FEED", "description": "Videos from mutual friends." },
    { "id": "explore", "label": "Explore", "kind": "EXPLORE", "description": "The Explore tab at the top of Home, on TikTok versions that have one." },
    { "id": "live", "label": "LIVE", "kind": "LIVE", "description": "Live streams." },
    { "id": "shop", "label": "Shop", "kind": "OTHER", "description": "TikTok Shop." },
    { "id": "video_viewer", "label": "Single videos", "kind": "VIDEO_VIEWER", "description": "A video opened from a chat, a profile or search." },
    { "id": "inbox", "label": "Inbox", "kind": "MESSAGES", "description": "Your inbox and chats. Never blocked." },
    { "id": "profile", "label": "Profiles", "kind": "PROFILE", "description": "Your profile and other people's. Never blocked." }
  ],
  "rules": [
    { "surface": "inbox", "all": ["inboxSelected"] },
    { "surface": "profile", "all": ["profileSelected"] },
    { "surface": "friends", "any": ["friendsSelected", "friendsTopSelected"] },
    { "surface": "live", "any": ["liveSelected", "liveRoom"] },
    { "surface": "shop", "all": ["shopSelected"] },
    { "surface": "explore", "all": ["exploreSelected"] },
    { "surface": "following", "all": ["followingSelected"] },
    { "surface": "for_you", "all": ["forYouSelected"] },
    { "surface": "inbox", "all": ["dmComposer"] },
    { "surface": "for_you", "all": ["topTabs", "videoActions"] },
    { "surface": "for_you", "all": ["homeSelected"] },
    { "surface": "video_viewer", "all": ["videoActions"], "none": ["topTabs", "homeSelected", "friendsSelected", "friendsTopSelected"] }
  ],
  "nav": [
    { "id": "inbox", "label": "Inbox", "signal": "inboxTab" },
    { "id": "friends", "label": "Friends", "signal": "friendsTab" },
    { "id": "profile", "label": "Profile", "signal": "profileTab" }
  ]
}
